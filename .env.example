# ---------------------------------------------------------------------------
# Book My Charter — environment
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# public. Anything without that prefix is server-only and must never gain it.
# ---------------------------------------------------------------------------

# --- Charter request delivery (SERVER ONLY) --------------------------------
# Where a submitted charter request is sent. With neither of these set, the
# API returns 503 and the form says submission is not connected. It does not
# accept and discard enquiries. See docs/BUSINESS-DATA-REQUIRED.md I7.
#
# CHARTER_SUBMISSION_PROVIDER: webhook | email | crm  (only webhook is implemented)
CHARTER_SUBMISSION_PROVIDER=""
# Destination for the webhook adapter: an email relay, CRM inbox or automation
# endpoint that accepts a JSON POST.
CHARTER_WEBHOOK_URL=""

# --- Measurement (public by necessity; these IDs are visible in any browser) -
# GA4 measurement ID from analytics.google.com. Unset: no script is loaded.
NEXT_PUBLIC_GA_ID=""
# Microsoft Clarity project ID from clarity.microsoft.com.
NEXT_PUBLIC_CLARITY_ID=""

# --- Search console verification -------------------------------------------
# Token only, not the whole meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
