{
  "name": "bookmycharter",
  "version": "1.0.0",
  "private": true,
  "description": "Book My Charter — private aviation and charter access platform",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "npm run airports && npm run aircraft && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "airports": "node scripts/build-airports.mjs",
    "verify": "npm run typecheck && npm run lint && node scripts/verify-routes.mjs && npm run build && node scripts/verify-build.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "aircraft": "node scripts/build-aircraft.mjs",
    "photos": "node scripts/ingest-aircraft-photos.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "lucide-react": "^0.546.0",
    "next": "^15.5.4",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
